# =============================================================================
# D'OUTRO LADO — Environment Variables Reference
# Copy the relevant sections to backend/.env and frontend/.env.local
# NEVER commit real values. This file is safe to commit.
# =============================================================================

# =============================================================================
# BACKEND  (doutro-lado/backend/.env)
# =============================================================================

NODE_ENV=development

# --- Database (required in production) ---
# Supabase → Project Settings → Database → Direct connection
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- App ---
APP_URL=http://localhost:3000

# --- Auth tokens (dev only — never use in production) ---
AUTH_MODE=token
ALLOW_DEV_AUTH_HEADERS=false
DEV_CUSTOMER_TOKEN=dev-customer-token
DEV_WHOLESALE_TOKEN=dev-wholesale-token
DEV_ADMIN_TOKEN=dev-admin-token

# --- Payments ---
# PAYMENTS_MODE=mock | stripe
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase SDK (optional — only if using supabaseAdmin client directly) ---
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Internal port (set automatically in production via start script) ---
# For local dev, set this if running backend standalone (default: 4000)
# INTERNAL_API_PORT=4000

# =============================================================================
# FRONTEND  (doutro-lado/frontend/.env.local)
# =============================================================================

# --- Internal API URL (server-side SSR, not exposed to browser) ---
# Points directly to the backend, bypassing the Next.js proxy
# In production on Render, backend is always at 127.0.0.1:4000
INTERNAL_API_URL=http://127.0.0.1:4000/api

# --- Public site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (only if frontend accesses Supabase directly) ---
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Legacy: explicit public API URL ---
# Optional for local dev. In production DO NOT set — the internal proxy handles it.
# If set, this takes priority over the proxy on the client side.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
