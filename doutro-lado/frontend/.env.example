# =============================================================================
# Supabase Auth — required for session management and auth UI
# Supabase → Project Settings → API → Project URL + anon key (public, safe to expose)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# =============================================================================
# Internal API routing
# =============================================================================
# Server-side: SSR fetches go directly to the backend (never exposed to the browser).
# In production on Render this is always http://127.0.0.1:4000/api
INTERNAL_API_URL=http://127.0.0.1:4000/api

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# Optional — local dev only
# =============================================================================
# Explicit API URL for browser dev proxy override.
# DO NOT set in production: Next.js rewrites handle proxying internally.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
