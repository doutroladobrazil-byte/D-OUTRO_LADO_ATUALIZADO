# Server-side: SSR fetches go directly to the backend (never exposed to the browser)
# In production on Render this is always http://127.0.0.1:4000/api
INTERNAL_API_URL=http://127.0.0.1:4000/api

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — only required if the frontend accesses Supabase directly
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Legacy explicit API URL (optional — local dev only)
# When set, the browser uses this URL instead of the internal proxy.
# DO NOT set in production: the proxy via Next.js rewrites replaces this.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
