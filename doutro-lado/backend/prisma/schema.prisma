generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth / Profiles
// =============================================================================

model Profile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId        String?  @unique @map("auth_user_id") @db.Uuid
  email             String   @unique
  fullName          String?  @map("full_name")
  role              String   @default("customer")
  isActive          Boolean  @default(true) @map("is_active")
  preferredLanguage String?  @default("en") @map("preferred_language")
  preferredCurrency String?  @default("USD") @map("preferred_currency")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  favorites            Favorite[]
  carts                Cart[]
  addresses            Address[]
  giftKits             GiftKit[]
  orders               Order[]
  recommendationEvents RecommendationEvent[]
  adminLogs            AdminLog[]

  @@map("profiles")
}

// =============================================================================
// Catalog
// =============================================================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand       String
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand            String
  categoryId       String?  @map("category_id") @db.Uuid
  subcategoryId    String?  @map("subcategory_id") @db.Uuid
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?  @map("short_description")
  longDescription  String?  @map("long_description")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  material         String?
  dimensions       String?
  origin           String?
  careInstructions String?  @map("care_instructions")
  weightRange      String   @map("weight_range")
  weightGrams      Int?     @map("weight_grams")
  retailPriceBrl   Decimal  @map("retail_price_brl") @db.Decimal(12, 2)
  wholesalePriceBrl Decimal? @map("wholesale_price_brl") @db.Decimal(12, 2)
  wholesaleMinQty  Int      @default(1) @map("wholesale_min_qty")
  stock            Int      @default(0)
  badge            String?
  collection       String?
  tags             String[] @default([])
  isFeatured       Boolean  @default(false) @map("is_featured")
  position         Int      @default(0)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          Subcategory?          @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images               ProductImage[]
  favorites            Favorite[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  giftKitItems         GiftKitItem[]
  recommendationEvents RecommendationEvent[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model WholesaleRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType      String   @map("target_type")
  targetId        String?  @map("target_id") @db.Uuid
  minQuantity     Int      @default(1) @map("min_quantity")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("wholesale_rules")
}

// =============================================================================
// Customer
// =============================================================================

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("favorites")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  brand     String
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile   Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([profileId, brand])
  @@map("carts")
}

model CartItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String  @map("profile_id") @db.Uuid
  country    String
  region     String?
  city       String?
  postalCode String? @map("postal_code")
  line1      String  @map("line_1")
  line2      String? @map("line_2")
  isDefault  Boolean @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("addresses")
}

// =============================================================================
// Shipping
// =============================================================================

model ShippingRegion {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  rates ShippingRate[]

  @@map("shipping_regions")
}

model ShippingRate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shippingRegionId String   @map("shipping_region_id") @db.Uuid
  weightRange      String   @map("weight_range")
  amountBrl        Decimal  @map("amount_brl") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shippingRegion ShippingRegion @relation(fields: [shippingRegionId], references: [id], onDelete: Cascade)

  @@unique([shippingRegionId, weightRange])
  @@map("shipping_rates")
}

// =============================================================================
// i18n
// =============================================================================

model Currency {
  code     String  @id
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  @@map("currencies")
}

model Language {
  code     String  @id
  label    String
  isActive Boolean @default(true) @map("is_active")

  @@map("languages")
}

// =============================================================================
// Gift Kits
// =============================================================================

model GiftKit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String?  @map("profile_id") @db.Uuid
  name             String
  message          String?
  packagingType    String?  @map("packaging_type")
  totalWeightRange String?  @map("total_weight_range")
  totalAmountBrl   Decimal? @default(0) @map("total_amount_brl") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile      Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  giftKitItems GiftKitItem[]

  @@map("gift_kits")
}

model GiftKitItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitId     String @map("kit_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)

  giftKit GiftKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("gift_kit_items")
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId      String   @unique @map("public_id")
  profileId     String?  @map("profile_id") @db.Uuid
  addressId     String?  @map("address_id") @db.Uuid
  brand         String
  currency      String   @default("USD")
  subtotalBrl   Decimal  @default(0) @map("subtotal_brl") @db.Decimal(12, 2)
  freightBrl    Decimal  @default(0) @map("freight_brl") @db.Decimal(12, 2)
  totalBrl      Decimal  @default(0) @map("total_brl") @db.Decimal(12, 2)
  orderStatus   String   @default("created") @map("order_status")
  paymentStatus String   @default("pending") @map("payment_status")
  fiscalStatus  String   @default("pending") @map("fiscal_status")
  shippingRegion String? @map("shipping_region")
  isExportOrder Boolean  @default(true) @map("is_export_order")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile        Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  address        Address?        @relation(fields: [addressId], references: [id])
  orderItems     OrderItem[]
  paymentRecords PaymentRecord[]
  fiscalRecords  FiscalRecord[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  brand        String
  productName  String  @map("product_name")
  sku          String?
  quantity     Int
  unitPriceBrl Decimal @map("unit_price_brl") @db.Decimal(12, 2)
  lineTotalBrl Decimal @map("line_total_brl") @db.Decimal(12, 2)
  weightRange  String  @map("weight_range")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model PaymentRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String   @default("stripe")
  providerPaymentId String?  @map("provider_payment_id")
  status            String
  amountBrl         Decimal  @map("amount_brl") @db.Decimal(12, 2)
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

model FiscalRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  invoiceNumber String?   @map("invoice_number")
  accessKey     String?   @map("access_key")
  observations  String?
  status        String    @default("pending")
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("fiscal_records")
}

// =============================================================================
// CMS
// =============================================================================

model Banner {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand     String
  title     String
  subtitle  String?
  highlight String?
  ctaLabel  String? @map("cta_label")
  ctaUrl    String? @map("cta_url")
  imageUrl  String? @map("image_url")
  isActive  Boolean @default(true) @map("is_active")
  position  Int     @default(0)

  @@map("banners")
}

model Slider {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand    String
  title    String
  subtitle String?
  ctaLabel String? @map("cta_label")
  ctaUrl   String? @map("cta_url")
  imageUrl String? @map("image_url")
  isActive Boolean @default(true) @map("is_active")
  position Int     @default(0)

  @@map("sliders")
}

model SiteSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// =============================================================================
// Analytics
// =============================================================================

model RecommendationEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("recommendation_events")
}

model AdminLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminProfileId String?  @map("admin_profile_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminProfile Profile? @relation(fields: [adminProfileId], references: [id])

  @@map("admin_logs")
}
