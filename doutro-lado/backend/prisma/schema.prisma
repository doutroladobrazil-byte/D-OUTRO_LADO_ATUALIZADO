generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooler — application queries
  directUrl = env("DIRECT_URL")     // direct — prisma migrate deploy
}

// NOTE: This schema is the declarative mirror of the runtime database.
// The project uses the `postgres` client (raw SQL) for all queries —
// Prisma is used only for migrations (prisma migrate deploy).
// No Prisma Client query methods are used in the application code.

// =============================================================================
// Auth / Profiles
// =============================================================================

model Profile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId        String?  @unique @map("auth_user_id") @db.Uuid
  email             String   @unique
  fullName          String?  @map("full_name")
  phone             String?
  role              String   @default("customer")
  isActive          Boolean  @default(true) @map("is_active")
  preferredLanguage String?  @default("en") @map("preferred_language")
  preferredCurrency String?  @default("USD") @map("preferred_currency")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  favorites            Favorite[]
  carts                Cart[]
  addresses            Address[]
  giftKits             GiftKit[]
  orders               Order[]
  recommendationEvents RecommendationEvent[]
  adminLogs            AdminLog[]

  @@map("profiles")
}

// =============================================================================
// Catalog
// =============================================================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand       String
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand             String
  categoryId        String?  @map("category_id") @db.Uuid
  subcategoryId     String?  @map("subcategory_id") @db.Uuid
  name              String
  slug              String   @unique
  sku               String   @unique
  shortDescription  String?  @map("short_description")
  longDescription   String?  @map("long_description")
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description")
  material          String?
  dimensions        String?
  origin            String?
  careInstructions  String?  @map("care_instructions")
  weightRange       String   @map("weight_range")
  weightGrams       Int?     @map("weight_grams")
  retailPriceBrl    Decimal  @map("retail_price_brl") @db.Decimal(12, 2)
  wholesalePriceBrl Decimal? @map("wholesale_price_brl") @db.Decimal(12, 2)
  wholesaleMinQty   Int      @default(1) @map("wholesale_min_qty")
  stock             Int      @default(0)
  /// Landed cost of the product (manufacturing + logistics in). Used for margin calculation only — never exposed in public catalog API.
  costPriceBrl      Decimal? @map("cost_price_brl") @db.Decimal(12, 2)
  badge             String?
  collection        String?
  tags              String[] @default([])
  isFeatured        Boolean  @default(false) @map("is_featured")
  position          Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory          Subcategory?          @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  // product_media is the current media join table (Stage 2+)
  productMedia         ProductMedia[]
  // product_images is the legacy table — kept for migration safety, deprecated in application code
  images               ProductImage[]
  favorites            Favorite[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  giftKitItems         GiftKitItem[]
  recommendationEvents RecommendationEvent[]
  translations         ProductTranslation[]
  countryAvailability  ProductCountryAvailability[]
  reservations         InventoryReservation[]

  @@map("products")
}

// =============================================================================
// Media — Stage 2
// =============================================================================

/// Stores metadata for media assets uploaded to Supabase Storage.
/// Physical files live in the storage bucket; this row holds the URL and metadata.
model MediaAsset {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand           String
  mediaType       String   @map("media_type")
  bucket          String
  storagePath     String   @unique @map("storage_path")
  publicUrl       String   @map("public_url")
  mimeType        String?  @map("mime_type")
  fileSizeBytes   Int?     @map("file_size_bytes")
  width           Int?
  height          Int?
  durationSeconds Float?   @map("duration_seconds")
  posterUrl       String?  @map("poster_url")
  altText         String?  @map("alt_text")
  caption         String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  productMedia ProductMedia[]

  @@map("media_assets")
}

/// Join table between products and media_assets.
/// Holds position and primary flag for ordered media galleries.
model ProductMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  position     Int      @default(0)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaAssetId])
  @@map("product_media")
}

/// @deprecated Legacy image table — superseded by media_assets + product_media (Stage 2).
/// Retained so existing migrations are not broken. Do not use in new application code.
model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model WholesaleRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType      String   @map("target_type")
  targetId        String?  @map("target_id") @db.Uuid
  minQuantity     Int      @default(1) @map("min_quantity")
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("wholesale_rules")
}

// =============================================================================
// Customer
// =============================================================================

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("favorites")
}

model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  brand     String
  currency  String   @default("USD")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile   Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([profileId, brand])
  @@map("carts")
}

model CartItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String  @map("profile_id") @db.Uuid
  country    String
  region     String?
  city       String?
  postalCode String? @map("postal_code")
  line1      String  @map("line_1")
  line2      String? @map("line_2")
  isDefault  Boolean @default(false) @map("is_default")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@map("addresses")
}

// =============================================================================
// Shipping
// =============================================================================

model ShippingRegion {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  rates ShippingRate[]

  @@map("shipping_regions")
}

model ShippingRate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shippingRegionId String   @map("shipping_region_id") @db.Uuid
  weightRange      String   @map("weight_range")
  amountBrl        Decimal  @map("amount_brl") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shippingRegion ShippingRegion @relation(fields: [shippingRegionId], references: [id], onDelete: Cascade)

  @@unique([shippingRegionId, weightRange])
  @@map("shipping_rates")
}

// =============================================================================
// i18n
// =============================================================================

model Currency {
  code     String  @id
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  @@map("currencies")
}

model Language {
  code     String  @id
  label    String
  isActive Boolean @default(true) @map("is_active")

  productTranslations ProductTranslation[]

  @@map("languages")
}

model ExchangeRate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrency String   @default("BRL") @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  source       String   @default("static")
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model ProductTranslation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  language         String
  name             String
  shortDescription String?  @map("short_description")
  longDescription  String?  @map("long_description")
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lang     Language @relation(fields: [language], references: [code])

  @@unique([productId, language])
  @@map("product_translations")
}

// =============================================================================
// Gift Kits
// =============================================================================

model GiftKit {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId             String?  @map("profile_id") @db.Uuid
  /// Brand isolation — kit items must all belong to this brand (casa | moda)
  brand                 String   @default("moda")
  name                  String
  message               String?
  packagingType         String   @default("standard") @map("packaging_type")
  subtotalBrl           Decimal  @default(0) @map("subtotal_brl") @db.Decimal(12, 2)
  packagingSurchargeBrl Decimal  @default(0) @map("packaging_surcharge_brl") @db.Decimal(12, 2)
  totalAmountBrl        Decimal  @default(0) @map("total_amount_brl") @db.Decimal(12, 2)
  totalWeightRange      String?  @map("total_weight_range")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile      Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  giftKitItems GiftKitItem[]

  @@map("gift_kits")
}

model GiftKitItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitId     String @map("kit_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int    @default(1)

  giftKit GiftKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("gift_kit_items")
}

// =============================================================================
// Orders
// =============================================================================

model Order {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId             String   @unique @map("public_id")
  profileId            String?  @map("profile_id") @db.Uuid
  addressId            String?  @map("address_id") @db.Uuid
  brand                String
  currency             String   @default("USD")
  subtotalBrl          Decimal  @default(0) @map("subtotal_brl") @db.Decimal(12, 2)
  freightBrl           Decimal  @default(0) @map("freight_brl") @db.Decimal(12, 2)
  totalBrl             Decimal  @default(0) @map("total_brl") @db.Decimal(12, 2)
  orderStatus          String   @default("created") @map("order_status")
  paymentStatus        String   @default("pending") @map("payment_status")
  fiscalStatus         String   @default("pending") @map("fiscal_status")
  shippingRegion       String?  @map("shipping_region")
  /// Aggregated weight range of all order items — used for freight quoting.
  estimatedWeightRange String?  @map("estimated_weight_range")
  /// Stripe checkout session ID — set after session creation, used by webhook.
  stripeSessionId      String?   @unique @map("stripe_session_id")
  /// Deterministic all-in pricing version string — encodes the rule used at checkout.
  pricingVersion       String?   @map("pricing_version")
  /// Timestamp of successful stock deduction. Null = not yet deducted. Used for idempotency.
  stockDeductedAt      DateTime? @map("stock_deducted_at") @db.Timestamptz(6)
  isExportOrder        Boolean   @default(true) @map("is_export_order")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Applied recovery offer code — null if no discount was used.
  offerCode            String?   @map("offer_code")
  /// Discount amount in BRL applied via offer code. Zero if no offer.
  discountBrl          Decimal   @default(0) @map("discount_brl") @db.Decimal(12, 2)

  // -------------------------------------------------------------------------
  // Stage 12 — Country-first snapshot columns (all nullable; not set for
  // orders created before Stage 12 or via legacy region-only flow).
  // -------------------------------------------------------------------------
  /// ISO 3166-1 alpha-2 code of the destination country selected at checkout.
  destinationCountryCode String?  @map("destination_country_code") @db.VarChar(2)
  /// Country name snapshot (denormalised for human-readable audit trail).
  destinationCountryName String?  @map("destination_country_name") @db.VarChar(100)
  /// Display currency used for this order (may differ from BRL canonical).
  destinationCurrency    String?  @map("destination_currency") @db.VarChar(3)
  /// BRL → destinationCurrency exchange rate at checkout (for audit).
  exchangeRateUsed       Decimal? @map("exchange_rate_used") @db.Decimal(10, 6)
  /// Minimum estimated delivery in business days from country_commerce_rules.
  deliveryEtaMinDays     Int?     @map("delivery_eta_min_days")
  /// Maximum estimated delivery in business days from country_commerce_rules.
  deliveryEtaMaxDays     Int?     @map("delivery_eta_max_days")

  // -------------------------------------------------------------------------
  // Stage 14 — Checkout contact + shipping address snapshots (all nullable).
  // Captured at purchase time so the order is fully operational without
  // depending on the profile or address records (which may change later).
  // Guest orders rely exclusively on these snapshots (profile_id = null).
  // Note: destination country is already in destination_country_code / name.
  // -------------------------------------------------------------------------
  customerNameSnapshot        String?  @map("customer_name_snapshot") @db.VarChar(200)
  customerEmailSnapshot       String?  @map("customer_email_snapshot") @db.VarChar(200)
  customerPhoneSnapshot       String?  @map("customer_phone_snapshot") @db.VarChar(50)
  shippingLine1Snapshot       String?  @map("shipping_line1_snapshot") @db.VarChar(200)
  shippingLine2Snapshot       String?  @map("shipping_line2_snapshot") @db.VarChar(200)
  shippingCitySnapshot        String?  @map("shipping_city_snapshot") @db.VarChar(100)
  shippingStateRegionSnapshot String?  @map("shipping_state_region_snapshot") @db.VarChar(100)
  shippingPostalCodeSnapshot  String?  @map("shipping_postal_code_snapshot") @db.VarChar(20)

  // -------------------------------------------------------------------------
  // Stage 16 — Financial snapshot columns (all nullable).
  // Historical orders (pre-Stage 16) will have NULL values.
  // product_cost_brl_snapshot = SUM(unit_cost × qty) for all items at order time.
  //   NULL when any product item has no cost_price_brl set.
  // gateway_fee_brl_snapshot  = ESTIMATED ~3.5% of total_brl (Stripe BR flat rate).
  //   Documented as an estimate; not a precise gateway record.
  // gross_margin_brl_snapshot = total_brl − product_cost_brl_snapshot
  // net_margin_brl_snapshot   = total_brl − product_cost_brl_snapshot − freight_brl − gateway_fee_brl_snapshot
  // -------------------------------------------------------------------------
  productCostBrlSnapshot  Decimal? @map("product_cost_brl_snapshot") @db.Decimal(12, 2)
  gatewayFeeBrlSnapshot   Decimal? @map("gateway_fee_brl_snapshot") @db.Decimal(12, 2)
  grossMarginBrlSnapshot  Decimal? @map("gross_margin_brl_snapshot") @db.Decimal(12, 2)
  netMarginBrlSnapshot    Decimal? @map("net_margin_brl_snapshot") @db.Decimal(12, 2)

  profile        Profile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  address        Address?        @relation(fields: [addressId], references: [id])
  orderItems     OrderItem[]
  paymentRecords PaymentRecord[]
  fiscalRecords  FiscalRecord[]
  reservations   InventoryReservation[]

  @@map("orders")
}

// =============================================================================
// Stage 15 — Inventory Reservations
// =============================================================================
// Temporary stock holds created at checkout start, before payment confirmation.
// Prevents oversell by atomically reserving stock while the user pays.
// Expires after RESERVATION_TTL_MINUTES (default 20) if payment is not received.

model InventoryReservation {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                  String?   @map("order_id") @db.Uuid
  stripeCheckoutSessionId  String?   @map("stripe_checkout_session_id") @db.VarChar(255)
  productId                String    @map("product_id") @db.Uuid
  quantity                 Int
  /// active | consumed | expired | released
  status                   String    @default("active") @db.VarChar(20)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, expiresAt], map: "idx_ir_product_status_expires")
  @@index([orderId], map: "idx_ir_order_id")
  @@index([stripeCheckoutSessionId], map: "idx_ir_stripe_session")
  @@map("inventory_reservations")
}

// =============================================================================
// Bag all-in pricing rules — Stage 11
// =============================================================================
// Configures regional surcharges applied on top of freight during simulation.
// v1: all values default to 0.00. Future stages may introduce non-zero rules
// via admin panel or manual migration.
//
// Runtime: loaded by bag.service.loadPricingRule() on every simulation call.
// If no active rule exists for a region, the service falls back to all-zeros.
// =============================================================================

model BagPricingRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region          String   @unique
  /// Flat tax component in BRL added to the order total. Default: 0.
  taxBrl          Decimal  @default(0) @map("tax_brl") @db.Decimal(12, 2)
  /// Flat logistics surcharge in BRL. Default: 0.
  logisticsBrl    Decimal  @default(0) @map("logistics_brl") @db.Decimal(12, 2)
  /// Percentage margin applied on top of (subtotal + freight + tax + logistics). Default: 0.
  marginPercent   Decimal  @default(0) @map("margin_percent") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bag_pricing_rules")
}

model OrderItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  /// Null for product-only items. Set when the line comes from a gift kit.
  giftKitId    String? @map("gift_kit_id") @db.Uuid
  brand        String
  productName  String  @map("product_name")
  sku          String?
  quantity     Int
  unitPriceBrl Decimal @map("unit_price_brl") @db.Decimal(12, 2)
  lineTotalBrl Decimal @map("line_total_brl") @db.Decimal(12, 2)
  weightRange  String  @map("weight_range")

  // Stage 16 — Cost snapshot at order creation. NULL when product has no cost_price_brl set.
  unitCostBrlSnapshot   Decimal? @map("unit_cost_brl_snapshot") @db.Decimal(12, 2)
  lineCostBrlSnapshot   Decimal? @map("line_cost_brl_snapshot") @db.Decimal(12, 2)
  lineMarginBrlSnapshot Decimal? @map("line_margin_brl_snapshot") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model PaymentRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String   @default("stripe")
  providerPaymentId String?  @map("provider_payment_id")
  status            String
  amountBrl         Decimal  @map("amount_brl") @db.Decimal(12, 2)
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

model FiscalRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String    @map("order_id") @db.Uuid
  invoiceNumber String?   @map("invoice_number")
  accessKey     String?   @map("access_key")
  observations  String?
  status        String    @default("pending")
  issuedAt      DateTime? @map("issued_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("fiscal_records")
}

// =============================================================================
// CMS
// =============================================================================

model Banner {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand     String
  title     String
  subtitle  String?
  highlight String?
  ctaLabel  String? @map("cta_label")
  ctaUrl    String? @map("cta_url")
  imageUrl  String? @map("image_url")
  isActive  Boolean @default(true) @map("is_active")
  position  Int     @default(0)

  @@map("banners")
}

model Slider {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand    String
  title    String
  subtitle String?
  ctaLabel String? @map("cta_label")
  ctaUrl   String? @map("cta_url")
  imageUrl String? @map("image_url")
  isActive Boolean @default(true) @map("is_active")
  position Int     @default(0)

  @@map("sliders")
}

model SiteSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

// =============================================================================
// Analytics
// =============================================================================

model RecommendationEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("recommendation_events")
}

model AdminLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminProfileId String?  @map("admin_profile_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminProfile Profile? @relation(fields: [adminProfileId], references: [id])

  @@map("admin_logs")
}

// =============================================================================
// Stage 12 — Country-first International
// =============================================================================

/// Master list of countries the platform can sell to.
/// is_active toggles the country globally; checkout_enabled/catalog_enabled
/// allow finer-grained control (browse-only vs full checkout).
model SupportedCountry {
  code             String   @id @db.VarChar(2)
  name             String   @db.VarChar(100)
  regionGroup      String   @map("region_group") @db.VarChar(50)
  defaultCurrency  String   @map("default_currency") @db.VarChar(3)
  defaultLanguage  String   @default("en") @map("default_language") @db.VarChar(5)
  isActive         Boolean  @default(true) @map("is_active")
  checkoutEnabled  Boolean  @default(true) @map("checkout_enabled")
  catalogEnabled   Boolean  @default(true) @map("catalog_enabled")
  displayPosition  Int      @default(0) @map("display_position")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  commerceRules  CountryCommerceRule[]
  shippingRules  CountryShippingRule[]

  @@map("supported_countries")
}

/// Per-country pricing rules — replaces BagPricingRule when a countryCode is
/// supplied. One active rule per country at a time.
model CountryCommerceRule {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode              String   @map("country_code") @db.VarChar(2)
  pricingCurrency          String   @map("pricing_currency") @db.VarChar(3)
  /// Tax percentage applied to subtotal (e.g. 7.7 for Swiss VAT).
  taxPercent               Decimal  @default(0) @map("tax_percent") @db.Decimal(6, 3)
  /// Flat BRL logistics surcharge per order.
  logisticsBrl             Decimal  @default(0) @map("logistics_brl") @db.Decimal(12, 2)
  /// Percentage margin on top of (subtotal + freight + tax + logistics).
  marginPercent            Decimal  @default(0) @map("margin_percent") @db.Decimal(5, 2)
  minimumOrderBrl          Decimal  @default(0) @map("minimum_order_brl") @db.Decimal(12, 2)
  allowGuestCheckout       Boolean  @default(true) @map("allow_guest_checkout")
  allowDiscountCodes       Boolean  @default(true) @map("allow_discount_codes")
  estimatedDeliveryMinDays Int      @default(5) @map("estimated_delivery_min_days")
  estimatedDeliveryMaxDays Int      @default(10) @map("estimated_delivery_max_days")
  isActive                 Boolean  @default(true) @map("is_active")
  notes                    String?
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country SupportedCountry @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@map("country_commerce_rules")
}

/// Stage 13 — opt-in availability per product per country.
/// A row with is_active = true means the product can be purchased in that country.
/// No row = unavailable (opt-in model). Populated by the admin panel.
model ProductCountryAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, countryCode])
  @@index([productId], map: "idx_pca_product_id")
  @@index([countryCode], map: "idx_pca_country_code")
  @@map("product_country_availability")
}

/// Per-country, per-weight-range freight table.
/// Parallel to shipping_rates (keyed by shipping_region_id); takes precedence
/// when countryCode is supplied to the bag simulator.
model CountryShippingRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode   String   @map("country_code") @db.VarChar(2)
  weightRange   String   @map("weight_range") @db.VarChar(20)
  baseAmountBrl Decimal  @map("base_amount_brl") @db.Decimal(12, 2)
  carrierLabel  String   @default("DHL Express") @map("carrier_label") @db.VarChar(100)
  slaMinDays    Int      @default(5) @map("sla_min_days")
  slaMaxDays    Int      @default(10) @map("sla_max_days")
  isActive      Boolean  @default(true) @map("is_active")

  country SupportedCountry @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@unique([countryCode, weightRange])
  @@map("country_shipping_rules")
}

// =============================================================================
// Bag recovery — Stage 11 Part 2
// =============================================================================

/// A time-limited discount offer code generated for an abandoned bag.
/// One offer per profile+brand+cart-version. Consumed exactly once.
model BagRecoveryOffer {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique human-readable code (e.g. RECOVAB3F7C). Sent in email/WhatsApp.
  code             String    @unique
  profileId        String?   @map("profile_id") @db.Uuid
  brand            String
  /// Cart fingerprint — ties this offer to the exact cart snapshot.
  cartVersionToken String    @map("cart_version_token")
  discountPercent  Decimal   @map("discount_percent") @db.Decimal(5, 2)
  validUntil       DateTime  @map("valid_until") @db.Timestamptz(6)
  isUsed           Boolean   @default(false) @map("is_used")
  usedAt           DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  abandonmentEvents BagAbandonmentEvent[]

  @@map("bag_recovery_offers")
}

/// Tracks each notification attempt for a bag recovery offer.
model BagAbandonmentEvent {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String?  @map("profile_id") @db.Uuid
  cartVersionToken String   @map("cart_version_token")
  offerId          String?  @map("offer_id") @db.Uuid
  /// Notification channel: "email" | "whatsapp"
  channel          String
  /// "sent" | "failed" | "skipped"
  status           String   @default("sent")
  sentAt           DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  offer BagRecoveryOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@map("bag_abandonment_events")
}
