NODE_ENV=development

# =============================================================================
# Database — direct Supabase connection (required in production)
# Supabase → Project Settings → Database → Direct connection string
# =============================================================================
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# App URL (used for CORS / redirect logic)
APP_URL=http://localhost:3000

# =============================================================================
# Auth — Supabase JWT verification
# Required in production for validating tokens issued by Supabase Auth.
# Supabase → Project Settings → API → JWT Settings → JWT Secret
# =============================================================================
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Dev-only static tokens — used for local testing without a real Supabase session.
# Map to roles: send as  Authorization: Bearer dev-customer-token  in requests.
# These are IGNORED in production (NODE_ENV=production bypasses this path).
DEV_CUSTOMER_TOKEN=dev-customer-token
DEV_WHOLESALE_TOKEN=dev-wholesale-token
DEV_ADMIN_TOKEN=dev-admin-token

# =============================================================================
# Data source and payments
# =============================================================================
DATA_SOURCE=supabase
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# Supabase SDK — required for Storage operations (product media upload/delete)
# Supabase → Project Settings → API → Service Role Key (secret, keep private)
# =============================================================================
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase Storage bucket name for product images and videos.
# Create in: Supabase Dashboard → Storage → New bucket → "product-media" (public)
SUPABASE_STORAGE_BUCKET_MEDIA=product-media

# Internal port — used when running backend standalone.
# In production, overridden by INTERNAL_API_PORT=4000 set in the root start script.
PORT=4000
