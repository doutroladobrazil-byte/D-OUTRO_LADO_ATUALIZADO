NODE_ENV=development

# Database — direct Supabase connection (required in production)
# Supabase → Project Settings → Database → Direct connection string
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# App URL (used for CORS / redirect logic)
APP_URL=http://localhost:3000

# Auth mode: "token" (default) | "header" (dev only, requires ALLOW_DEV_AUTH_HEADERS=true)
AUTH_MODE=token
ALLOW_DEV_AUTH_HEADERS=false

# Dev bearer tokens — map to roles (do not use in production)
DEV_CUSTOMER_TOKEN=dev-customer-token
DEV_WHOLESALE_TOKEN=dev-wholesale-token
DEV_ADMIN_TOKEN=dev-admin-token

# Data source: "memory" (no DB) | "supabase" (database)
DATA_SOURCE=supabase

# Payments: "mock" (no charge) | "stripe"
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase SDK (optional — only if using supabaseAdmin directly)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Internal port — used when running backend standalone
# In production, overridden by INTERNAL_API_PORT=4000 set in the root start script
PORT=4000
